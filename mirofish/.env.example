# MiroFish config for MacroMiro (xAI Grok). Copy to mirofish/.env and fill keys. Never commit .env.
# Keep first simulations under 40 rounds; token use is high.
LLM_API_KEY=
LLM_BASE_URL=https://api.x.ai/v1
LLM_MODEL_NAME=grok-4.7

# Zep Cloud memory graph (free tier: https://app.getzep.com/)
ZEP_API_KEY=

# MacroMiro desk patches (optional)
# Bearer token required on /api when set; MacroMiro's client reads it from this file (MIROFISH_ENV_FILE).
MIROFISH_AUTH_TOKEN=
# Route LLM calls through the local cost meter (scripts/llm-meter-proxy.ts), e.g. http://127.0.0.1:8788/v1
MIROFISH_LLM_METER_URL=
