# Desk schedule. Times are New York. Install on a machine with cron:  crontab ops/crontab
# Read-only reports and data refresh only. Nothing here places an order.
CRON_TZ=America/New_York
SHELL=/bin/bash
D=/workspace/mm-main
# 6:00 AM bias brief, 7:00 AM scan, 4:00 PM review (weekdays); weekly review Sunday 6:00 PM
0 6 * * 1-5   cd $D && bun scripts/desk-reports.ts bias   >> /tmp/desk-cron.log 2>&1
0 7 * * 1-5   cd $D && bun scripts/desk-reports.ts scan   >> /tmp/desk-cron.log 2>&1
0 16 * * 1-5  cd $D && bun scripts/desk-reports.ts review >> /tmp/desk-cron.log 2>&1
0 18 * * 0    cd $D && bun scripts/desk-reports.ts weekly >> /tmp/desk-cron.log 2>&1 && bun scripts/fills-vs-51.ts >> /tmp/desk-cron.log 2>&1
# Fresh bars (crypto + gold) and headline tone every 30 minutes, before the reports read them
*/30 * * * *  cd $D && bun scripts/signal-fetch-bars.ts 3 >> /tmp/desk-cron.log 2>&1 && bun scripts/signal-fetch-extra.ts 3 gold >> /tmp/desk-cron.log 2>&1
15 */2 * * *  cd $D && bun scripts/signal-fetch-extra.ts 2 tone >> /tmp/desk-cron.log 2>&1
# Research worker: keep it running (the script loops itself; flock stops duplicates)
*/5 * * * *   cd $D && flock -n /tmp/intel-worker.lock bun scripts/intel-worker.ts --loop 30 >> /tmp/intel-worker.log 2>&1
# Weekly retrain + perps rules backtest, Sunday 5:00 PM
0 17 * * 0    cd $D && bun scripts/signal-perps.ts >> /tmp/desk-cron.log 2>&1 && bun scripts/signal-train.ts >> /tmp/desk-cron.log 2>&1
